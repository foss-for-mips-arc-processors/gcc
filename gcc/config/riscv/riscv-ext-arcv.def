DEFINE_RISCV_EXT(
  /* NAME */ xarcvudsp,
  /* UPPERCASE_NAME */ XARCVUDSP,
  /* FULL_NAME */ "ARC-V micro-DSP extension",
  /* DESC */ "",
  /* URL */ ,
  /* DEP_EXTS */ ({}),
  /* SUPPORTED_VERSIONS */ ({{1, 0}}),
  /* FLAG_GROUP */ xarcv,
  /* BITMASK_GROUP_ID */ BITMASK_NOT_YET_ALLOCATED,
  /* BITMASK_BIT_POSITION*/ BITMASK_NOT_YET_ALLOCATED,
  /* EXTRA_EXTENSION_FLAGS */ 0)

