empty =
space = $(empty) $(empty)

MULTILIB_OPTIONS =
MULTILIB_DIRNAMES =
MULTILIB_REQUIRED =
MULTILIB_REUSE =

# ABI multilib for a single i8500 Linux toolchain (tune via --with-tune=).
arcv_march_variants = rv64imacb_zicond_zicbop_zicboz_zcb
arcv_march_variants += rv64imafdcb_zicond_zicbop_zicboz_zcb_zfa

MULTILIB_OPTIONS    += $(subst $(space),/,$(patsubst %,march=%,$(arcv_march_variants)))
MULTILIB_DIRNAMES   += $(arcv_march_variants)

MULTILIB_OPTIONS    += mabi=lp64/mabi=lp64d
MULTILIB_DIRNAMES   += lp64      lp64d

MULTILIB_REQUIRED   += march=rv64imacb_zicond_zicbop_zicboz_zcb/mabi=lp64
MULTILIB_REQUIRED   += march=rv64imafdcb_zicond_zicbop_zicboz_zcb_zfa/mabi=lp64d
