empty =
space = $(empty) $(empty)

MULTILIB_OPTIONS =
MULTILIB_DIRNAMES =
MULTILIB_REQUIRED =
MULTILIB_REUSE =

# Reduced march variants: one per mtune
arcv_march_variants  = rv32imac_zcb_zba_zbb_zbs_zfinx_zdinx_zicsr
arcv_march_variants += rv32imafd_zca_zcb_zba_zbb_zbs

MULTILIB_OPTIONS    += $(subst $(space),/,$(patsubst %,march=%,$(arcv_march_variants)))
MULTILIB_DIRNAMES   += $(arcv_march_variants)

MULTILIB_OPTIONS    += mabi=ilp32/mabi=ilp32d
MULTILIB_DIRNAMES   +=      ilp32      ilp32d

MULTILIB_OPTIONS    += mtune=arc-v-rmx-500-series/mtune=arc-v-rmx-700-series/mtune=arc-v-rhx-100-series
MULTILIB_DIRNAMES   +=       rmx500                     rmx700                     rhx100

# One configuration per mtune target:

# RMX-100 (default tune)
MULTILIB_REQUIRED   += march=rv32imac_zcb_zba_zbb_zbs_zfinx_zdinx_zicsr/mabi=ilp32

# RMX-500
MULTILIB_REQUIRED   += march=rv32imac_zcb_zba_zbb_zbs_zfinx_zdinx/mabi=ilp32/mtune=arc-v-rmx-500-series

# RMX-700
MULTILIB_REQUIRED   += march=rv32imafd_zca_zcb_zba_zbb_zbs/mabi=ilp32d/mtune=arc-v-rmx-700-series

# RHX-100
MULTILIB_REQUIRED   += march=rv32imafd_zca_zcb_zba_zbb_zbs/mabi=ilp32d/mtune=arc-v-rhx-100-series
