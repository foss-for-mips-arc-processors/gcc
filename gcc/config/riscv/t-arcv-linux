empty =
space = $(empty) $(empty)

MULTILIB_OPTIONS =
MULTILIB_DIRNAMES =
MULTILIB_REQUIRED =
MULTILIB_REUSE =

# -march multilib options for MIPS i8500
arcv_march_variants = rv64imacb_zicond_zicbop_zicboz_zcb
arcv_march_variants += rv64imafdcb_zicond_zicbop_zicboz_zcb_zfa
# -march multilib options for RPX-100
arcv_march_variants += rv64imac_zcb_zba_zbb_zbs
arcv_march_variants += rv64imafdc_zcb_zba_zbb_zbs

MULTILIB_OPTIONS    += $(subst $(space),/,$(patsubst %,march=%,$(arcv_march_variants)))
MULTILIB_DIRNAMES   += $(arcv_march_variants)

MULTILIB_OPTIONS    += mabi=lp64/mabi=lp64d
MULTILIB_DIRNAMES   += lp64      lp64d

MULTILIB_OPTIONS    += mtune=mips-i8500/mtune=arc-v-rpx-100-series
MULTILIB_DIRNAMES   += i8500 rpx100

MULTILIB_OPTIONS    += mcmodel=medany
MULTILIB_DIRNAMES   += medany

# Configurations for MIPS i8500
MULTILIB_REQUIRED   += march=rv64imacb_zicond_zicbop_zicboz_zcb/mabi=lp64/mtune=mips-i8500
MULTILIB_REQUIRED   += march=rv64imafdcb_zicond_zicbop_zicboz_zcb_zfa/mabi=lp64d/mtune=mips-i8500

# Configurations for RPX-100
MULTILIB_REQUIRED   += march=rv64imac_zcb_zba_zbb_zbs/mabi=lp64/mtune=arc-v-rpx-100-series/mcmodel=medany
MULTILIB_REQUIRED   += march=rv64imafdc_zcb_zba_zbb_zbs/mabi=lp64d/mtune=arc-v-rpx-100-series/mcmodel=medany

# Install shared libs where ld.so searches (/lib64/<abi>), not under
# per-CPU build directories.  t-linux applies this after rewriting
# MULTILIB_DIRNAMES.
RISCV_LINUX_ABI_OSDIRS = yes
riscv_default_abi := $(patsubst TARGET_RISCV_DEFAULT_ABI=%,%,$(filter TARGET_RISCV_DEFAULT_ABI=%,$(tm_defines)))
