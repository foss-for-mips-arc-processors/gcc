RISCV_BUILTIN (pmhaccsu_b1_i16x2, "pmhaccsu_b1_i16x2", RISCV_BUILTIN_DIRECT, RISCV_V2HI_FTYPE_V2HI_V2HI_UV4QI, simd),
/* h-series i32 (scalar, RMW): RV32 mhacc.hN/mhaccsu.hN; RV64 pmhacc.w.hN/etc  */
RISCV_BUILTIN (mhacc_h0_i32, "mhacc_h0_i32", RISCV_BUILTIN_DIRECT, RISCV_SI_FTYPE_SI_SI_V2HI, simd),
RISCV_BUILTIN (mhacc_h1_i32, "mhacc_h1_i32", RISCV_BUILTIN_DIRECT, RISCV_SI_FTYPE_SI_SI_V2HI, simd),
