/* b-series i16x4 (packed, RMW): RV64 single pmhacc.h.bN; RV32 2x  */
RISCV_BUILTIN (pmhacc_b0_i16x4, "pmhacc_b0_i16x4", RISCV_BUILTIN_DIRECT, RISCV_V4HI_FTYPE_V4HI_V4HI_V8QI, simd),
RISCV_BUILTIN (pmhacc_b1_i16x4, "pmhacc_b1_i16x4", RISCV_BUILTIN_DIRECT, RISCV_V4HI_FTYPE_V4HI_V4HI_V8QI, simd),
