/* h-series i32x2 (packed, RMW): RV64 pmhacc.w.hN; RV32 2x mhacc.hN  */
RISCV_BUILTIN (pmhacc_h0_i32x2, "pmhacc_h0_i32x2", RISCV_BUILTIN_DIRECT, RISCV_V2SI_FTYPE_V2SI_V2SI_V4HI, simd),
RISCV_BUILTIN (pmhacc_h1_i32x2, "pmhacc_h1_i32x2", RISCV_BUILTIN_DIRECT, RISCV_V2SI_FTYPE_V2SI_V2SI_V4HI, simd),
