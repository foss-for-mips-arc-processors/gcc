RISCV_BUILTIN (pmhaccsu_h1_i32x2, "pmhaccsu_h1_i32x2", RISCV_BUILTIN_DIRECT, RISCV_V2SI_FTYPE_V2SI_V2SI_UV4HI, simd),

/* Packed Widening Multiply (RV32 single insn; RV64 multi-insn sequence TODO)  */
RISCV_BUILTIN (pwmul_i16x4, "pwmul_i16x4", RISCV_BUILTIN_DIRECT, RISCV_V4HI_FTYPE_V4QI_V4QI, simd32),
